// WoW TBC Loot Tracker

generator client {
  provider = "prisma-client-js"
}

// Postgres (Supabase). DATABASE_URL uses the pooled connection for runtime;
// DIRECT_URL is the direct connection used by `prisma migrate` and `prisma db push`.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Phase {
  id    Int    @id @default(autoincrement())
  name  String
  order Int    @unique
  raids Raid[]
}

model Raid {
  id        Int    @id @default(autoincrement())
  name      String
  shortName String @unique
  order     Int
  phaseId   Int
  phase     Phase  @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  bosses    Boss[]

  @@index([phaseId])
}

model Boss {
  id     Int    @id @default(autoincrement())
  name   String
  order  Int
  raidId Int
  raid   Raid   @relation(fields: [raidId], references: [id], onDelete: Cascade)
  items  Item[]

  @@unique([raidId, name])
  @@index([raidId])
}

model Item {
  id         Int          @id @default(autoincrement())
  name       String
  slot       String?
  itemLevel  Int?
  wowheadId  Int?         @unique
  notes      String?
  bossId     Int
  boss       Boss         @relation(fields: [bossId], references: [id], onDelete: Cascade)
  weights    ItemWeight[]
  awards     LootAward[]

  @@index([bossId])
}

model ItemWeight {
  id     Int    @id @default(autoincrement())
  itemId Int
  spec   String
  weight Float
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, spec])
  @@index([itemId])
}

model Player {
  id            Int         @id @default(autoincrement())
  displayName   String      @unique
  discordHandle String?
  notes         String?
  active        Boolean     @default(true)
  createdAt     DateTime    @default(now())
  characters    Character[]
}

model Character {
  id          Int            @id @default(autoincrement())
  name        String
  class       String
  spec        String
  role        String // 'tank' | 'heal' | 'dps'
  active      Boolean        @default(true)
  createdAt   DateTime       @default(now())
  // Optional Player ownership: a Player can have many Characters (main + alts).
  // Orphan characters (playerId = null) still work everywhere; UI offers to
  // bind them to a Player via /players. SetNull preserves loot history if
  // a Player is deleted.
  playerId    Int?
  isMain      Boolean        @default(false)
  // WarcraftLogs (Fresh) identity + cached parse numbers. realm/region
  // feed the API lookup; wcl* fields are refreshed by /api/wcl/refresh.
  realm            String    @default("Nightslayer")
  region           String    @default("US")
  wclBestPerfAvg   Float?
  wclMedianPerfAvg Float?
  wclKillsLogged   Int?
  wclData          Json?
  wclUpdatedAt     DateTime?
  player      Player?        @relation(fields: [playerId], references: [id], onDelete: SetNull)
  memberships RosterMember[]
  attendance  Attendance[]
  awards      LootAward[]

  @@index([playerId])
}

model Roster {
  id          Int            @id @default(autoincrement())
  name        String         @unique
  description String?
  createdAt   DateTime       @default(now())
  members     RosterMember[]
  raidNights  RaidNight[]
  awards      LootAward[]
}

model RosterMember {
  id          Int       @id @default(autoincrement())
  rosterId    Int
  characterId Int
  memberRole  String    @default("main") // 'main' | 'bench' | 'trial'
  roster      Roster    @relation(fields: [rosterId], references: [id], onDelete: Cascade)
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([rosterId, characterId])
  @@index([rosterId])
  @@index([characterId])
}

model RaidNight {
  id         Int          @id @default(autoincrement())
  rosterId   Int
  date       DateTime
  notes      String?
  roster     Roster       @relation(fields: [rosterId], references: [id], onDelete: Cascade)
  attendance Attendance[]
  awards     LootAward[]

  @@index([rosterId])
}

model Attendance {
  id          Int       @id @default(autoincrement())
  raidNightId Int
  characterId Int
  status      String // 'present' | 'late' | 'absent'
  raidNight   RaidNight @relation(fields: [raidNightId], references: [id], onDelete: Cascade)
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([raidNightId, characterId])
  @@index([raidNightId])
  @@index([characterId])
}

model LootAward {
  id          Int        @id @default(autoincrement())
  itemId      Int
  characterId Int
  rosterId    Int
  raidNightId Int?
  awardedAt   DateTime   @default(now())
  notes       String?
  item        Item       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  character   Character  @relation(fields: [characterId], references: [id], onDelete: Cascade)
  roster      Roster     @relation(fields: [rosterId], references: [id], onDelete: Cascade)
  raidNight   RaidNight? @relation(fields: [raidNightId], references: [id], onDelete: SetNull)

  @@index([itemId])
  @@index([characterId])
  @@index([rosterId])
  @@index([raidNightId])
}

// ─────────────────────────────────────────────────────────────────────────
// Raid Assignments
// ─────────────────────────────────────────────────────────────────────────
// A RaidTeam is one weekly raid roster (e.g. "Sunday Main", "Wednesday
// Alt Run"). Up to ~3 per week is the expected scale. The team itself is
// long-lived (it carries an identity + accent colour); the actual roster
// composition + boss assignments live in AssignmentSheet snapshots, one
// per (team, week).
model RaidTeam {
  id        Int               @id @default(autoincrement())
  name      String            @unique
  color     String            @default("#1e3a5f")
  active    Boolean           @default(true)
  notes     String?
  createdAt DateTime          @default(now())
  sheets    AssignmentSheet[]
}

// One AssignmentSheet = one (team, weekOf) snapshot. The `data` JSON blob
// holds the entire sheet body — groups, buffs, per-boss assignments —
// so the schema stays flexible while the editor UX evolves. Shape is
// documented in lib/assignments.ts.
//   data = {
//     groups:    { "1": [charId,...], "2": [...], "3": [...], "4": [...], "5": [...] }
//     buffs:     { powerInfusion: { "G1-3": charId, "G4-5": charId }, fortitude: [...], ... }
//     bosses:    { "hydross": { sections: [{ title, characterIds }, ...] }, ... }
//   }
model AssignmentSheet {
  id        Int       @id @default(autoincrement())
  teamId    Int       @unique
  // Legacy week key, kept nullable for history. Each team now has exactly
  // one persistent sheet; weekOf is no longer used for lookups.
  weekOf    DateTime?
  data      Json      @default("{}")
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  team      RaidTeam  @relation(fields: [teamId], references: [id], onDelete: Cascade)
}
