# Neon Postgres. Grab both URLs from the Neon dashboard > Connection Details.
# DATABASE_URL is the POOLED connection used at runtime (hostname has `-pooler`).
# DIRECT_URL is the DIRECT connection used by `prisma migrate` / `prisma db push`
# (same hostname without `-pooler`).
DATABASE_URL="postgresql://<user>:<password>@ep-xxxx-pooler.<region>.aws.neon.tech/<db>?sslmode=require&pgbouncer=true&connect_timeout=15"
DIRECT_URL="postgresql://<user>:<password>@ep-xxxx.<region>.aws.neon.tech/<db>?sslmode=require"

# Generate with: node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
# In .env files escape every $ as \$ (Next.js expands env vars dotenv-style).
# In the Vercel dashboard you do NOT need to escape $.
ADMIN_PASSWORD_HASH="\$2a\$10\$replace-with-a-real-bcrypt-hash-of-your-admin-password"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-with-a-long-random-hex-string"
